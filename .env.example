# Copy to `.env.local` and fill in real values. Never commit `.env.local`.

# -----------------------------------------------------------------------------
# Client (Vite / browser) — Firebase JS SDK
# Get from: Firebase Console → Project settings → Your apps → Web app config
# -----------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# -----------------------------------------------------------------------------
# Server (webhook) — Firebase Admin SDK (Firestore writes from Node)
# Not the same as VITE_* — you need a service account private key.
# Get from: Firebase Console → Project settings → Service accounts → Generate new private key
#
# Use EITHER (1) OR (2), not both.
# -----------------------------------------------------------------------------

# (1) Single JSON string (minify to one line in production). Escaped newlines in private_key.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk-...@....iam.gserviceaccount.com",...}

# (2) Split credentials (often easier in Vercel / local .env)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Use \n for line breaks inside the key, or wrap in double quotes with real newlines in .env.local
FIREBASE_PRIVATE_KEY=