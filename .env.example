# Copy to `.env.local` and fill in. Never commit `.env.local`.
# Firebase Console → Project settings → Service accounts → Generate new private key

# Use EITHER (1) OR (2), not both.

# (1) One-line JSON from the downloaded key file
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...@....iam.gserviceaccount.com",...}

# (2) Same file, split
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional
# PORT=3000
# WEBHOOK_DEBUG=0
